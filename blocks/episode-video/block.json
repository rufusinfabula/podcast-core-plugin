{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "podcast-core/episode-video",
  "title": "Episode Video",
  "category": "media",
  "icon": "video-alt3",
  "description": "The episode's video (Episode details → Video URL), on its own. Use it with the Episode Player's \"Show video\" turned off to place the video elsewhere, for example after the episode text.",
  "keywords": [
    "podcast",
    "video",
    "youtube",
    "episode"
  ],
  "textdomain": "podcast-core-engine",
  "usesContext": [
    "postId",
    "postType"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./editor.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "selectors": {
    "root": ".wp-block-podcast-core-episode-video"
  }
}
